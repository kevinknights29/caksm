\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces Weak scaling at a fixed local volume of ${\approx }227{,}000$ rows per GPU (\Cref  {sec:integrator-weak}). Dotted rules mark perfectly flat weak scaling from the two-GPU value; efficiency is measured against a one-GPU run at the same local volume. The hatched bar left a Krylov cycle unconverged and is drawn as a stop, not as a performance result.}}{47}{figure.caption.72}\protected@file@percent }
\newlabel{fig:ca-weak}{{A.1}{47}{Weak scaling at a fixed local volume of ${\approx }227{,}000$ rows per GPU (\Cref {sec:integrator-weak}). Dotted rules mark perfectly flat weak scaling from the two-GPU value; efficiency is measured against a one-GPU run at the same local volume. The hatched bar left a Krylov cycle unconverged and is drawn as a stop, not as a performance result}{figure.caption.72}{}}
\newlabel{fig:ca-weak@cref}{{[figure][1][0]A.1}{[1][47][]47}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces The recurrence-depth correction, arm against arm (\Cref  {sec:integrator-depth}). Both arms were attempted in one job on the same devices, so each pair is a controlled comparison rather than two runs from two allocations. Percentages are the change from \texttt  {as-measured} to \texttt  {exact-depth}; hollow hatched bars produced no result.}}{47}{figure.caption.73}\protected@file@percent }
\newlabel{fig:ca-correction}{{A.2}{47}{The recurrence-depth correction, arm against arm (\Cref {sec:integrator-depth}). Both arms were attempted in one job on the same devices, so each pair is a controlled comparison rather than two runs from two allocations. Percentages are the change from \texttt {as-measured} to \texttt {exact-depth}; hollow hatched bars produced no result}{figure.caption.73}{}}
\newlabel{fig:ca-correction@cref}{{[figure][2][0]A.2}{[1][47][]47}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Collective and halo latency against payload on idle V100s across two nodes (\Cref  {tab:ca-participants}, \Cref  {tab:app-halo}). Both payload axes are logarithmic. The shaded band in the first panel is the payload range the integrator's collectives occupy; the third panel is the ratio of the two, which is the participant-count term a single node-tier constant cannot express.}}{48}{figure.caption.74}\protected@file@percent }
\newlabel{fig:ca-participants}{{A.3}{48}{Collective and halo latency against payload on idle V100s across two nodes (\Cref {tab:ca-participants}, \Cref {tab:app-halo}). Both payload axes are logarithmic. The shaded band in the first panel is the payload range the integrator's collectives occupy; the third panel is the ratio of the two, which is the participant-count term a single node-tier constant cannot express}{figure.caption.74}{}}
\newlabel{fig:ca-participants@cref}{{[figure][3][0]A.3}{[1][47][]48}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.4}{\ignorespaces Calibrated communication-floor saving against measured cycle-time saving from $s=1$ to $s=4$ (\Cref  {sec:integrator-account}). Both use the same time units, but the calibrated components overlap device work and cannot be added as a causal decomposition. The discrepancy records that non-additivity.}}{48}{figure.caption.75}\protected@file@percent }
\newlabel{fig:ca-predicted}{{A.4}{48}{Calibrated communication-floor saving against measured cycle-time saving from $s=1$ to $s=4$ (\Cref {sec:integrator-account}). Both use the same time units, but the calibrated components overlap device work and cannot be added as a causal decomposition. The discrepancy records that non-additivity}{figure.caption.75}{}}
\newlabel{fig:ca-predicted@cref}{{[figure][4][0]A.4}{[1][48][]48}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.5}{\ignorespaces Orthogonalization cost and orthogonality loss on identical blocks (\Cref  {tab:ca-orth}). Each group is one block: the same $n$, $m$, $s$, basis, and payoff across all three methods. The dashed rule is the solver's Krylov stopping tolerance, which is the scale on which an orthogonality loss either matters or does not.}}{49}{figure.caption.76}\protected@file@percent }
\newlabel{fig:ca-orthogonalization}{{A.5}{49}{Orthogonalization cost and orthogonality loss on identical blocks (\Cref {tab:ca-orth}). Each group is one block: the same $n$, $m$, $s$, basis, and payoff across all three methods. The dashed rule is the solver's Krylov stopping tolerance, which is the scale on which an orthogonality loss either matters or does not}{figure.caption.76}{}}
\newlabel{fig:ca-orthogonalization@cref}{{[figure][5][0]A.5}{[1][48][]49}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.6}{\ignorespaces Largest odd grid the allocation model admits per topology, payoff, and block width (\Cref  {tab:app-memory}). The dashed rule is the common grid selected for the sweep, the minimum over every arm. The prediction was made before any allocation, so the physical limit was a decision input rather than a job that dies minutes in.}}{49}{figure.caption.77}\protected@file@percent }
\newlabel{fig:ca-memory}{{A.6}{49}{Largest odd grid the allocation model admits per topology, payoff, and block width (\Cref {tab:app-memory}). The dashed rule is the common grid selected for the sweep, the minimum over every arm. The prediction was made before any allocation, so the physical limit was a decision input rather than a job that dies minutes in}{figure.caption.77}{}}
\newlabel{fig:ca-memory@cref}{{[figure][6][0]A.6}{[1][49][]49}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.7}{\ignorespaces Cost of the independent referee against grid size (\Cref  {sec:integrator-solver}, \Cref  {tab:app-referee}), for the fixed compatibility contract and the promoted scaled-augmentation method. Both vertical axes are logarithmic. The Basket compatibility contract was never run above $n=31$, so its series stops where the evidence does.}}{50}{figure.caption.78}\protected@file@percent }
\newlabel{fig:ca-referee}{{A.7}{50}{Cost of the independent referee against grid size (\Cref {sec:integrator-solver}, \Cref {tab:app-referee}), for the fixed compatibility contract and the promoted scaled-augmentation method. Both vertical axes are logarithmic. The Basket compatibility contract was never run above $n=31$, so its series stops where the evidence does}{figure.caption.78}{}}
\newlabel{fig:ca-referee@cref}{{[figure][7][0]A.7}{[1][49][]50}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.8}{\ignorespaces The initialization-arm A/B contrast at $n=61$ (\Cref  {sec:locality}). Naive master-thread initialization and parallel first-touch are indistinguishable, which is the control that makes the schedule experiment necessary: on a single-NUMA socket with a per-CCX victim cache, residency is set by which core \emph  {accesses} a row, not by which thread first-touched the page.}}{50}{figure.caption.79}\protected@file@percent }
\newlabel{fig:ab}{{A.8}{50}{The initialization-arm A/B contrast at $n=61$ (\Cref {sec:locality}). Naive master-thread initialization and parallel first-touch are indistinguishable, which is the control that makes the schedule experiment necessary: on a single-NUMA socket with a per-CCX victim cache, residency is set by which core \emph {accesses} a row, not by which thread first-touched the page}{figure.caption.79}{}}
\newlabel{fig:ab@cref}{{[figure][8][0]A.8}{[1][50][]50}{}{}{}}
